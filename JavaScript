// ------------------------------
// MOSTRAR MANHÃ E TARDE
// ------------------------------

function renderPeriods() {

  const periods = [

    [
      "manha",
      "Manhã",
      "07h às 12h"
    ],

    [
      "tarde",
      "Tarde",
      "13h às 17h"
    ]

  ];


  const appointments =
    getAppointments();


  $("periods").innerHTML =
    periods.map(
      ([id, name, time]) => {

        const count =
          appointments.filter(
            appointment =>

              appointment.ubsId ===
                state.ubs.id &&

              appointment.specialtyId ===
                state.specialty.id &&

              appointment.date ===
                state.date &&

              appointment.period ===
                id

          ).length;


        const full =
          count >= 10;


        return `

          <button
            class="period ${
              full ? "disabled" : ""
            }"
            ${full ? "disabled" : ""}
            data-period="${id}">

            <strong>
              ☀ ${name}
            </strong>

            <span>
              ${time}
              •
              ${count}/10 vagas ocupadas
            </span>

          </button>

        `;

      }
    ).join("");


  document
    .querySelectorAll(
      ".period:not(.disabled)"
    )
    .forEach(button => {

      button.onclick = () => {

        confirmAppointment(
          button.dataset.period
        );

      };

    });

}


// ------------------------------
// CONFIRMAR AGENDAMENTO
// ------------------------------

function confirmAppointment(period) {

  state.period = period;


  const appointments =
    getAppointments();


  const count =
    appointments.filter(
      appointment =>

        appointment.ubsId ===
          state.ubs.id &&

        appointment.specialtyId ===
          state.specialty.id &&

        appointment.date ===
          state.date &&

        appointment.period ===
          period

    ).length;


  // Limite de 10 pessoas

  if (count >= 10) {

    toast(
      "Esta fila já atingiu 10 vagas."
    );

    renderPeriods();

    return;
  }


  // Criar agendamento

  const appointment = {

    id: Date.now(),

    name:
      state.patient.name,

    phone:
      state.patient.phone,

    sus:
      state.patient.sus,

    ubsId:
      state.ubs.id,

    ubsName:
      state.ubs.name,

    specialtyId:
      state.specialty.id,

    specialtyName:
      state.specialty.name,

    date:
      state.date,

    period:
      period,

    position:
      count + 1

  };


  appointments.push(
    appointment
  );


  localStorage.setItem(
    "conectaSaudeAppointments",
    JSON.stringify(appointments)
  );


  // Mostrar confirmação

  const date =
    new Date(
      state.date + "T12:00:00"
    );


  $("confirmationText")
    .textContent =
    `${state.patient.name}, sua consulta foi registrada na ${state.ubs.name}.`;


  $("queueBox").innerHTML = `

    <div>
      Sua posição na fila é
    </div>

    <div class="queue-number">
      ${appointment.position}º
    </div>

    <div>

      <strong>
        ${state.specialty.name}
      </strong>

      •

      ${date.toLocaleDateString(
        "pt-BR"
      )}

      •

      ${
        period === "manha"
          ? "Manhã"
          : "Tarde"
      }

    </div>

  `;


  $("userGreeting")
    .textContent =
    `Olá, ${state.patient.name.split(" ")[0]}`;


  $("userGreeting")
    .classList.remove(
      "hidden"
    );


  renderAppointments();

  show(
    "confirmationSection"
  );


  toast(
    "Agendamento confirmado!"
  );

}


