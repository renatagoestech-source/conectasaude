// ------------------------------
// VERIFICAR FERIADOS
// ------------------------------

function holidayKey(date) {

  const year = date.getFullYear();

  const month =
    date.getMonth() + 1;

  const day =
    date.getDate();


  const fixedHolidays = [

    `${year}-01-01`,
    `${year}-04-21`,
    `${year}-05-01`,
    `${year}-09-07`,
    `${year}-10-12`,
    `${year}-11-02`,
    `${year}-11-15`,
    `${year}-11-20`,
    `${year}-12-25`

  ];


  const movingHolidays = {

    2026: [
      "2026-02-16",
      "2026-02-17",
      "2026-04-03"
    ],

    2027: [
      "2027-02-08",
      "2027-02-09",
      "2027-03-26"
    ],

    2028: [
      "2028-02-28",
      "2028-02-29",
      "2028-04-14"
    ]

  };


  const key =
    `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;


  return (
    fixedHolidays.includes(key) ||
    (movingHolidays[year] || []).includes(key)
  );
}


// ------------------------------
// CONVERTER DATA PARA ISO
// ------------------------------

function dateISO(date) {

  return `${date.getFullYear()}-${String(
    date.getMonth() + 1
  ).padStart(2, "0")}-${String(
    date.getDate()
  ).padStart(2, "0")}`;

}


// ------------------------------
// VERIFICAR SE DATA ESTÁ DISPONÍVEL
// ------------------------------

function isAvailable(date) {

  const day =
    date.getDay();

  // 0 = domingo
  // 6 = sábado

  return (
    day !== 0 &&
    day !== 6 &&
    !holidayKey(date)
  );

}


// ------------------------------
// CRIAR CALENDÁRIO
// ------------------------------

function buildCalendar() {

  const calendar =
    $("calendar");


  const today =
    new Date();

  today.setHours(
    0,
    0,
    0,
    0
  );


  const firstMonth =
    new Date(
      today.getFullYear(),
      today.getMonth(),
      1
    );


  let html = "";


  // Mostrar próximos 3 meses

  for (
    let monthOffset = 0;
    monthOffset < 3;
    monthOffset++
  ) {

    const first =
      new Date(
        firstMonth.getFullYear(),
        firstMonth.getMonth() + monthOffset,
        1
      );


    const days =
      new Date(
        first.getFullYear(),
        first.getMonth() + 1,
        0
      ).getDate();


    html += `

      <div style="
        grid-column:1/-1;
        font-weight:800;
        padding:9px 0;
      ">

        ${first.toLocaleDateString(
          "pt-BR",
          {
            month: "long",
            year: "numeric"
          }
        )}

      </div>

    `;


    const weekDays = [
      "Dom",
      "Seg",
      "Ter",
      "Qua",
      "Qui",
      "Sex",
      "Sáb"
    ];


    weekDays.forEach(day => {

      html += `
        <div class="weekday">
          ${day}
        </div>
      `;

    });


    // Espaços antes do primeiro dia

    for (
      let i = 0;
      i < first.getDay();
      i++
    ) {

      html += "<div></div>";

    }


    // Dias

    for (
      let number = 1;
      number <= days;
      number++
    ) {

      const date =
        new Date(
          first.getFullYear(),
          first.getMonth(),
          number
        );


      const iso =
        dateISO(date);


      const available =
        isAvailable(date) &&
        date >= today;


      const selected =
        state.date === iso
          ? "selected"
          : "";


      html += `

        <button
          class="day ${selected}"
          ${available ? "" : "disabled"}
          data-date="${iso}"
          title="${
            holidayKey(date)
              ? "Feriado"
              : ""
          }">

          ${number}

        </button>

      `;

    }

  }


  calendar.innerHTML =
    html;


  document
    .querySelectorAll(".day:not(:disabled)")
    .forEach(button => {

      button.onclick = () => {

        selectDate(
          button.dataset.date
        );

      };

    });

}


