      event.target.value
        .replace(/\D/g, "")
        .slice(0, 11);


    if (value.length > 6) {

      event.target.value =
        `(${value.slice(0, 2)}) ` +
        `${value.slice(2, 7)}-` +
        `${value.slice(7)}`;

    }

    else if (value.length > 2) {

      event.target.value =
        `(${value.slice(0, 2)}) ` +
        value.slice(2);

    }

    else {

      event.target.value =
        value;

    }

  };


