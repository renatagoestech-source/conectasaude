      );


    renderStaffList();

  };


// ------------------------------
// LISTA DE FUNCIONÁRIOS
// ------------------------------

function renderStaffList() {

  const ubs =
    UBS.find(
      item =>
        item.id ===
        $("staffUBS").value
    );


  $("staffList").innerHTML =

    ubs.employees
      .map(
        employee => `

          <div class="employee">

            <strong>
              ${escapeHTML(
                employee[0]
              )}
            </strong>

            <span>
              ${escapeHTML(
                employee[1]
              )}
            </span>

          </div>

        `
      )
      .join("");

}


// ------------------------------
// TROCAR UBS NO PAINEL
// ------------------------------

$("staffUBS").onchange =
  () => {

    if (
      !$("staffPanel")
        .classList.contains(
          "hidden"
        )
    ) {

      renderStaffList();

    }

  };


// ------------------------------
// CADASTRAR FUNCIONÁRIO
// ------------------------------

$("staffForm").onsubmit =
  event => {

    event.preventDefault();


    const ubs =
      UBS.find(
        item =>
          item.id ===
          $("staffUBS").value
      );


    const name =
      $("staffName")
        .value
        .trim();


    const role =
      $("staffRole")
        .value
        .trim();


    ubs.employees.push([
      name,
      role
    ]);


    $("staffName").value = "";

    $("staffRole").value = "";


    renderStaffList();

    renderInfo();


    toast(
      "Funcionário cadastrado nesta demonstração."
    );

  };


// ------------------------------
// INICIALIZAR SISTEMA
// ------------------------------

renderInfo();
