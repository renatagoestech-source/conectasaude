function renderAppointments() {

  if (!state.patient) {

    $("myAppointments")
      .classList.add("hidden");

    return;
  }


  const appointments =
    getAppointments().filter(
      appointment =>
        appointment.sus ===
        state.patient.sus
    );


  if (!appointments.length) {

    $("myAppointments")
      .classList.add("hidden");

    return;
  }


  $("myAppointments")
    .classList.remove(
      "hidden"
    );


  $("appointmentsList")
    .innerHTML =

    appointments
      .slice()
      .reverse()
      .map(appointment => {

        const date =
          new Date(
            appointment.date +
            "T12:00:00"
          );


        return `

          <div class="appointment">

            <strong>
              ${appointment.ubsName}
            </strong>

            —
            ${appointment.specialtyName}

            <br>

            📅
            ${date.toLocaleDateString(
              "pt-BR"
            )}

            •

            ${
              appointment.period ===
              "manha"
                ? "Manhã"
                : "Tarde"
            }

            •

            <strong>
              ${appointment.position}º
              na fila
            </strong>

            <br>

            <button
              class="back-btn reminder"
              data-id="${appointment.id}">

              🔔 Ativar lembrete na tela

            </button>

          </div>

        `;

      })
      .join("");


  document
    .querySelectorAll(".reminder")
    .forEach(button => {

      button.onclick = () => {

        toast(
          "Lembrete ativado! Ele será exibido quando você abrir este site."
        );

      };

    });

}


